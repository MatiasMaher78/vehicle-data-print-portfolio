# Backend / Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Comma-separated frontend origins allowed by FastAPI CORS.
# Local development defaults are http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Storage bucket that contains DOCX templates.
DOCX_TEMPLATE_BUCKET=plantillas-docx
